# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection URL (use Atlas connection string for production)
MONGO_URI=mongodb://localhost:27017/infotact_project2

# Redis Cache Configuration
# Redis connection URL (use cluster URL for production)
REDIS_URL=redis://localhost:6379

# Authentication Keys
# Secret key used for signing JWT session tokens (min 32 characters recommended)
JWT_SECRET=your_super_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend Connection
# Allowed origin for client WebSockets and CORS policies
CLIENT_URL=http://localhost:5173
